extends RefCounted
const Objectives = preload("res://scripts/gameplay/objectives.gd")
const TITLES = ["Situation actuelle", "Temps et commandes", "Régions et objectif", "Évolutions et prérequis", "Détection et remède", "Événements et routes", "Sauvegardes", "Dégel 2042", "Transports", "Décision logistique"]

static func text_for(topic: int, world: RefCounted, selected: int, training_stage: int = -1) -> String:
	var text = _base_text_for(topic,world,selected,training_stage)
	if not world.regions.is_empty() and world.crises_enabled:
		if topic in [0,5]: text += "\n\nAléas et résilience · Graine %d. Douze incidents sont tirés au lancement, à dates, durées et cibles variables. Favorable ou défavorable se rapporte à la diffusion. Tempête : fermeture maritime ; séisme : croissance régionale freinée ; panne aérienne : échanges réduits. Des reprises d'échanges et retards du remède peuvent vous favoriser. Le calendrier futur reste caché. Recommencer conserve la graine ; Autre au menu change le tirage. Les fins et cumuls suivent les mêmes règles que les autres événements." % world.rng.seed
		if topic == 3: text += "\n\nRésilience : Liaisons de secours (10 pts, exige Mobilité) divise par deux les pénalités de transport des aléas ; Veille scientifique (11 pts, exige Discrétion) divise par deux leurs accélérations du remède ; Réserves régionales (9 pts, exige Relais locaux) divise par deux leurs pénalités de croissance. Ces compétences n'atténuent pas les événements classiques, ne modifient pas les occasions favorables et ne rouvrent aucune liaison fermée."
		if topic == 6: text += "\n\nCette partie utilise le profil crises-0.20, format 6. La graine reconstitue le même calendrier d'aléas lors du chargement. Les formats classiques 4 et enrichis 5 restent reconnus sans ajout rétroactif d'aléas."
		if topic == 0 and world.scenario.id == "fragile2042": text += "\n\nRéseaux fragiles : départ en Centrale, incidents espacés d'environ six jours, croissance ×0,95 jusqu'au J44, remède ×1,15 à partir du J45. Objectif principal habituel ; aucun objectif facultatif ni décision portuaire dans ce scénario."
	if not world.regions.is_empty() and world.tactics_enabled:
		if topic in [0,5,9]: text += "\n\nCrises réactives : seuls les aléas régionaux de croissance choisissent, au déclenchement, un foyer actif ayant encore des sains. La première panne aérienne ouvre une réponse intégrée [F2], pendant trois journées : détour (3 points, air ×1,35), subir (gratuit, panne conservée), occasion (1 point, air ×1,70 et remède ×1,18). Les coefficients se multiplient avec la panne pendant les six jours suivant le choix ; aucune route fermée n'est rouverte. Sans choix, subir est retenu gratuitement."
		if topic == 6: text += "\n\nCette partie réactive utilise plutôt tactics-0.22, format 7 : cibles résolues, réponse et Double relais sont enregistrés. Les profils historiques restent séparés."
		if topic in [0,2] and world.scenario.id == "fragile2042": text += "\n\nDouble relais obligatoire : 6 000 unités abstraites sortant de Centrale vers Méridien ET vers Savane avant J60 inclus. L'échéance manquée entraîne la défaite ; la couverture de 90 % exige également la réussite des deux relais. Les unités mesurent les flux sur routes ouvertes, pas de nouvelles infections."
	return text

static func _base_text_for(topic: int, world: RefCounted, selected: int, training_stage: int = -1) -> String:
	match topic:
		0:
			if world.regions.is_empty(): return "Choisissez un scénario, une difficulté et une région, puis lancez Nouvelle partie.\n\nVous commencez en pause. Le tutoriel guidé est facultatif et accessible au menu."
			var region = world.regions[selected]
			var lines = ["%s · %s · Jour %d" % [world.scenario.name, world.difficulty.name, world.day],
				"Objectif : toucher 90 % de la population avant 100 % de remède. L'extinction des cas actifs entraîne aussi une défaite.",
				"%s : %s. %d actifs et %d retirés sur %d habitants." % [region.name, "détectée" if region.detected else "non détectée", region.active, region.removed, region.population],
				"Évolutions"]
			for id in world.evolutions:
				var reason = world.purchase_reason(id)
				if training_stage >= 0 and id not in world.purchased and (training_stage != 2 or id != "transmission"):
					reason = "Hors exercice" + (" · " + reason if not reason.is_empty() else "")
				lines.append("%s : %s" % [world.evolutions[id].name, "Disponible" if reason.is_empty() else reason])
			lines.append("Événements actifs")
			lines.append("Aucun effet temporaire." if world.active_events.is_empty() else "\n".join(world.active_event_lines()))
			lines.append(Objectives.summary(world))
			if not world.decision.is_empty(): lines.append(world.Decisions.summary(world))
			return "\n\n".join(lines)
		1: return "Espace : pause ou reprise. 1, 2, 4 : vitesse. Une journée dure une demi-seconde à ×1.\n\nF1 : ouvrir ou fermer cette aide. Échap : fermer l'aide, revenir depuis Sauvegardes, ou rejoindre le menu depuis la partie. Tout retour à la partie se fait en pause.\n\nTab et Maj + Tab : parcourir les contrôles. Entrée : activer le contrôle sélectionné. Carte : molette pour zoomer ; glisser au bouton droit ou central pour déplacer. Tab permet de focaliser la carte : + / − pour zoomer, flèches pour déplacer, Origine pour la vue mondiale. Les boutons −, + et Vue mondiale restent en haut de la carte. Le focus sur une région hors champ la ramène dans la vue. Toutes les évolutions sont visibles dans la grille. Sélectionner consulte la fiche ; le bouton Évoluer confirme séparément la dépense. En partie, F2 met en pause et ramène aux choix intégrés de la décision logistique."
		2: return "Sélectionnez une région pour voir les sains, actifs et retirés. Retirés signifie sortis de l'état actif.\n\nLe cumul touché additionne actifs et retirés ; une personne n'est comptée qu'une fois. Les points rouges et les halos illustrent cette proportion près des foyers sur la carte du monde. Les marqueurs numérotés se sélectionnent au clic ou avec Tab puis Entrée ; le nom et les chiffres exacts apparaissent à droite. Ces points ne représentent pas des personnes localisées.\n\nVictoire : 90 % de population touchée. Défaite : remède à 100 %, ou plus aucun actif avant l'objectif. Si plusieurs fins coïncident, le remède est prioritaire.\n\nPremiers relais est facultatif, à activer avant une nouvelle partie Standard : trois régions à 10 % touchés, au plus tard à la fin du jour 50. Le suivi se fige à la réussite, à l'échéance ou à la fin de partie. Aucun point ni bonus de score ; réussite facultative et victoire principale sont indépendantes. Les anciennes parties n'en reçoivent pas rétroactivement.\n\nDans Dégel, Relais arctiques compte les échanges sortants de Boréale vers Orient à partir du jour 36 et Centrale à partir du jour 39 : 1 000 unités sur chaque route avant la fin du jour 54. Ces unités abstraites sont les échanges calculés par les routes ouvertes, même vers une région déjà touchée ; elles ne comptent pas des personnes transportées. Les tempêtes et inspections restent prioritaires. Les compteurs sont plafonnés et figés après résolution, sans bonus."
		3: return "Les points augmentent de 3 tous les cinq jours. Une évolution s'achète une seule fois. Son coût, son effet et la raison d'un refus sont affichés à droite.\n\nDiffusion augmente la croissance locale. Mobilité multiplie les échanges et exige Diffusion. Discrétion ralentit le remède.\n\nAprès Mobilité, un seul choix de spécialisation est possible pour toute la partie : Réseau terrestre (9 pts, terre ×1,8, remède +8 %), Pont aérien (10 pts, air ×3, remède +18 %) ou Logistique maritime (10 pts, mer ×2,5, remède +12 %). Les deux autres choix deviennent incompatibles. Le choix est facultatif et ne peut pas être annulé.\n\nUn prérequis doit déjà être acquis et les points doivent suffire. Aucun achat n'est possible après la fin de partie."
		4: return "Dans le standard en difficulté normale, une région est détectée à partir de 500 actifs ET de 1,5 % de sa population active. La difficulté modifie le seuil proportionnel.\n\nLa première détection lance le remède ; chaque région détectée renforce sa progression. Une réaction réduit la croissance locale de 20 % pendant huit jours. Elle ne se déclenche qu'une fois par région.\n\nConsultez le compteur mondial, l'état de la région et les événements actifs pour distinguer détection permanente et réaction temporaire."
		5: return "Courbes discrètes : réseau du jeu. Pointillés et croix ambre : route fermée. Les véhicules rouges montrent les échanges orientés calculés pour la journée courante ; leur animation se fige en pause. Après un chargement, les flèches reviennent au prochain jour simulé. Une fermeture bloque les nouveaux cas importés par cette route ; les cas déjà présents continuent localement.\n\nLes effets peuvent se cumuler. Si deux événements ferment la même route, elle ne rouvre qu'après la fin des deux. Les jours restants et les fins sont annoncés dans les événements et le journal.\n\nUn effet de huit jours commencé au jour 18 s'applique du jour 18 au 25 inclus. Au jour 26, il a expiré."
		6: return "Ouvrez Sauvegardes depuis le menu, la partie ou le bilan. Trois emplacements manuels et un automatique sont locaux à ce PC. Charger remplace la partie en mémoire, après confirmation, et reprend en pause.\n\nL'automatique est actualisée tous les dix jours, à la fin de partie, au menu depuis le jeu et à la fermeture normale. Une fermeture forcée ne garantit pas les changements récents.\n\nLe secours contient l'enregistrement précédent. Si le principal manque ou est endommagé, un secours valide est chargé avec avertissement. Une version incompatible est refusée sans écrasement.\n\nPendant le tutoriel, seuls des fichiers d'entraînement séparés sont utilisés."
		7: return "Dégel 2042 impose Boréale et ajoute des évolutions climatiques.\n\nJour 0 : Isolement, une seule sortie ouverte. Jour 12 : Ouverture des routes saisonnières. Jour 28 : Instabilité et tempêtes. Jour 55 : Mobilisation du remède.\n\nUne ouverture saisonnière ne supprime pas une fermeture temporaire. Consultez la phase, les températures fictives et le multiplicateur Climat local.\n\nAdaptation polaire améliore la croissance froide. Mobilité saisonnière et Résilience climatique exigent cette adaptation."
		8:
			var intro = "T : terrestre, coefficient ×1. A : aérien, ×1,2. M : maritime, ×0,8. Les liaisons sont courbes sur la carte du monde ; les croix ambre signalent les fermetures. Le détail ci-dessous indique le type et le coefficient de chaque route.\n\nLe coefficient de transport inclut la spécialisation choisie et les effets temporaires du même type. Il se multiplie ensuite avec Mobilité et les bonus saisonniers. Une route fermée ne laisse passer aucun échange. Les facteurs sont des paramètres fictifs du jeu."
			if world.regions.is_empty(): return intro
			return intro + "\n\nLiaisons de " + world.regions[selected].name + " (coefficient transport, hors Mobilité et bonus saisonnier)\n\n" + "\n\n".join(world.transport_lines(world.regions[selected].id))
		9: return "Activez Décision logistique (J28) avant une nouvelle partie Dégel. Elle est désactivée par défaut et absente des anciennes sauvegardes.\n\nAu jour 28, la partie s'arrête en pause : les trois choix apparaissent sous la carte, avec toutes les évolutions toujours visibles. Soutenir les ports coûte %d points : mer ×1,50 et remède ×1,15. Limiter les échanges est gratuit : mer ×0,65 et remède ×0,85. Maintenir la situation est gratuit, sans effet supplémentaire.\n\nChaque effet dure douze journées à partir du lendemain du choix. Au J28, il s'applique du J29 au J40 inclus. Les facteurs se multiplient avec les autres effets ; les routes fermées restent fermées.\n\nUn seul choix est possible. Vous pouvez continuer à observer et sauvegarder sans décider. F1 ou Échap ferme cette aide. En partie, F2 met en pause et ramène aux choix intégrés. Le choix reste disponible jusqu'au J30 inclus ; au J31, le maintien neutre est automatique. Sauvegarder conserve les points, le choix et son expiration. Les parties 0.11 conservent leur tarif de 6 points ; une nouvelle partie depuis la 0.12 coûte 3 points." % world.Decisions.option("support",world).cost
	return ""
