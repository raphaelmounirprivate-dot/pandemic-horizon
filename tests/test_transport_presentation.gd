extends RefCounted
const World = preload("res://scripts/simulation/world.gd")
const Map = preload("res://scripts/ui/region_map.gd")
const Store = preload("res://scripts/persistence/save_store.gd")
func run(tree: SceneTree, check: Callable) -> void:
	var world = World.new()
	world.start("boreale")
	for i in range(70): world.step()
	var map = Map.new()
	map.setup(world)
	tree.root.add_child(map)
	map.size = Vector2(732,300)
	await tree.process_frame
	var before = Store.new().encode(world)
	before.erase("saved_at")
	check.call(map.terrain_mesh.get_surface_count() == 1,"Terrain triangulé en un maillage réutilisable")
	check.call(map.projected_coasts.size() == map.polygons.size(),"Contours préparés hors de la boucle de dessin")
	for mode in ["land","air","sea"]:
		map.set_flow_filter(mode)
		check.call(map.visible_flows().all(func(flow): return flow.mode == mode and world.route_is_open([flow.from,flow.to])),"Filtre de transport ne montre que les flux ouverts : "+mode)
		check.call(map.filter_button.text != "Flux : tous","Filtre courant explicite")
	map.set_flow_filter("all")
	check.call(map.visible_flows().size() == world.latest_flows.size(),"Tous les échanges du jour accessibles sans filtre")
	map.cycle_filter()
	check.call(map.flow_filter == "land","Cycle tous vers terre sans menu déroulant")
	map.cycle_filter()
	map.cycle_filter()
	map.cycle_filter()
	check.call(map.flow_filter == "all","Cycle des quatre filtres revient à tous")
	map.set_flow_filter("sea")
	var camera = map.camera_state()
	map.set_flow_filter("air")
	map.restore_camera(camera)
	check.call(map.flow_filter == "sea","Filtre conservé avec la caméra en mémoire")
	map.set_flow_filter("unknown")
	check.call(map.flow_filter == "all","Filtre inconnu revient à tous")
	var geometry = map.projected_coasts.duplicate()
	map.zoom_at(map.size*.5,2)
	check.call(map.projected_coasts != geometry,"Zoom met à jour les contours sans reconstruire le maillage")
	var after = Store.new().encode(world)
	after.erase("saved_at")
	check.call(before == after,"Filtres et terrain sans changement du monde ou des sauvegardes")
	map.queue_free()
	await tree.process_frame
