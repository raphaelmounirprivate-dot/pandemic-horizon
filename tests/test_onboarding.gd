extends RefCounted
const World = preload("res://scripts/simulation/world.gd")
const Store = preload("res://scripts/persistence/save_store.gd")
const Help = preload("res://scripts/ui/help.gd")

func snapshot(store: RefCounted, world: RefCounted) -> Dictionary:
	var data = store.encode(world)
	data.erase("saved_at")
	return data

func run(tree: SceneTree, check: Callable) -> void:
	var io = load("res://tests/input_journey.gd").new()
	var files = load("res://tests/test_persistence.gd").new()
	var scene = load("res://scenes/main.tscn").instantiate()
	tree.root.add_child(scene)
	scene.set_process(false)
	scene.training_directory = "user://tests-training"
	scene.save_store.directory = "user://tests-onboarding"
	files.clean(scene.save_store)
	await tree.process_frame
	for topic in range(Help.TITLES.size()):
		check.call(not Help.text_for(topic, scene.world, 0).is_empty(), "Aide disponible au menu : " + Help.TITLES[topic])
	await io.key(tree, KEY_F1)
	check.call(scene.screen == "help" and scene.paused, "F1 ouvre l'aide au menu")
	await io.key(tree, KEY_F1)
	check.call(scene.screen == "menu", "F1 ferme l'aide sans lancer de partie")
	scene.scenario_id = "degel2042"
	scene.difficulty_id = "hard"
	scene.start_game()
	for i in range(33): scene.world.step()
	scene.selected = 9
	scene.speed = 4
	scene._refresh()
	var original = scene.world
	var original_store = scene.save_store
	var before = snapshot(original_store, original)
	check.call(original_store.save_slot("slot1", original).is_empty(), "Partie témoin sauvegardée")
	var original_file = FileAccess.get_file_as_string(original_store._path("slot1"))
	scene.paused = false
	await io.click(tree, files.button_named(scene, "Aide [F1]"))
	check.call(scene.screen == "help" and scene.paused and "Dégel 2042" in scene.help_text.text and original.regions[9].name in scene.help_text.text, "Aide contextuelle du scénario et de la région sélectionnée")
	scene.advance_time(100)
	check.call(snapshot(original_store, original) == before, "Aide ne fait pas progresser le monde ni le RNG")
	await io.key(tree, KEY_ESCAPE)
	check.call(scene.screen == "game" and scene.paused and scene.selected == 9 and scene.speed == 4, "Retour de l'aide conserve la sélection et la vitesse")
	scene.open_saves()
	await io.key(tree, KEY_F1)
	await io.key(tree, KEY_F1)
	check.call(scene.screen == "saves", "Retour d'aide vers les sauvegardes")
	scene.close_saves()
	scene.start_tutorial()
	scene.autosave_enabled = true
	check.call(scene.world != original and scene.world.scenario.id == "standard" and scene.tutorial.stage == 0, "Entraînement séparé du monde courant")
	check.call(scene.paused and scene.world.day == 0 and scene.tutorial_next.disabled, "Tutoriel facultatif démarre en pause")
	scene.next_lesson()
	check.call(scene.tutorial.stage == 0, "Étape suivante attend une action réussie")
	await io.key(tree, KEY_SPACE)
	scene.advance_time(5)
	check.call(scene.world.day == 1 and scene.paused and scene.tutorial.ready, "Espace fait passer exactement une journée d'entraînement")
	await io.click(tree, scene.tutorial_next)
	check.call(scene.tutorial.stage == 1 and not scene.tutorial.ready, "Continuer ouvre la sélection régionale")
	scene.select_region(0)
	check.call(not scene.tutorial.ready, "La région demandée doit être sélectionnée")
	await io.click(tree, scene.map_view.buttons[2])
	check.call(scene.tutorial.ready and "Centrale" in scene.region_details.text, "Clic sur Centrale valide la lecture régionale")
	scene.next_lesson()
	await tree.process_frame
	await tree.process_frame
	check.call(scene.tutorial.stage == 2 and scene.world.day == 10 and scene.world.points == 14 and scene.paused, "Points gagnés par les règles normales avant l'achat")
	scene.open_evolution()
	await tree.process_frame
	await tree.process_frame
	check.call(scene.screen == "evolution" and scene.paused, "L'écran Évolution s'ouvre en pause pendant l'exercice")
	check.call("Prérequis" in scene.evolution_reasons.mobility.text, "Prérequis de Mobilité visible dans l'exercice")
	scene.buy_evolution("mobility")
	check.call(scene.world.purchased.is_empty(), "L'exercice ne permet pas l'achat d'une autre évolution")
	await io.click(tree, scene.evolution_buttons.transmission)
	await io.click(tree, scene.evolution_purchase)
	check.call(scene.tutorial.ready and scene.world.points == 2 and "transmission" in scene.world.purchased, "Achat réel de Diffusion validé")
	check.call(scene.evolution_back.has_focus(), "Après l'achat, le retour à la carte est ciblé")
	scene.close_evolution()
	check.call(scene.screen == "game" and scene.tutorial_next.has_focus(), "Retour à la carte : Continuer ciblé")
	scene.next_lesson()
	check.call(scene.world.day == 23 and scene.world.detected_count() > 0, "Détection réelle atteinte dans l'exercice")
	scene.select_region(0)
	check.call(scene.tutorial.ready and "Détectée" in scene.region_details.text, "Lecture de Boréale détectée valide l'étape")
	scene.next_lesson()
	check.call(scene.tutorial.stage == 4 and not scene.world.route_is_open(["boreale", "centrale"]), "Exercice de deux fermetures simultanées")
	scene.toggle_pause()
	scene.advance_time(20)
	check.call(scene.world.day == 26 and scene.paused and not scene.tutorial.ready and not scene.world.route_is_open(["boreale", "centrale"]), "Arrêt au jour 26 : inspection encore active")
	check.call("inspection" in scene.journal_label.text, "Instruction actualisée après expiration de la tempête")
	scene.toggle_pause()
	scene.advance_time(20)
	check.call(scene.world.day == 32 and scene.paused and scene.tutorial.ready and scene.world.route_is_open(["boreale", "centrale"]), "Arrêt au jour 32 : route rouverte après tous les effets")
	scene.next_lesson()
	check.call(scene.tutorial.stage == 5 and scene.save_store != original_store, "Dernier exercice avec stockage séparé")
	scene.autosave()
	check.call(not FileAccess.file_exists(scene.save_store._path("auto")), "Pas d'automatique de la partie d'entraînement")
	scene.open_saves()
	await tree.process_frame
	await io.click(tree, files.button_named(scene, "Enregistrer ici"))
	check.call(scene.tutorial.saved_slot == "slot1" and FileAccess.file_exists(scene.save_store._path("slot1")), "Enregistrement réel dans l'emplacement d'essai")
	scene.load_saved("slot1")
	check.call(scene.tutorial.ready and scene.paused and scene.world.day == 32, "Chargement réel valide le tutoriel")
	check.call(FileAccess.get_file_as_string(original_store._path("slot1")) == original_file and snapshot(original_store, original) == before, "Partie et fichier d'origine inchangés après six exercices")
	files.clean(scene.save_store)
	scene.next_lesson()
	check.call(scene.tutorial == null and scene.world == original and scene.save_store == original_store and scene.screen == "game" and scene.paused, "Terminer restitue le monde initial en pause")
	check.call(scene.selected == 9 and scene.speed == 4 and scene.scenario_id == "degel2042" and scene.difficulty_id == "hard", "Choix et paramètres initiaux restitués")
	for target in ["menu", "game", "saves", "help"]:
		scene.show_menu()
		scene.start_tutorial()
		if target == "saves": scene.open_saves()
		elif target == "help": scene.open_help()
		await io.key(tree, KEY_ESCAPE)
		if target in ["saves", "help"]:
			check.call(scene.tutorial != null and scene.screen == "game", "Échap ferme " + target + " avant l'entraînement")
			await io.key(tree, KEY_ESCAPE)
		check.call(scene.tutorial == null and scene.world == original and scene.screen == "menu", "Quitter tôt restitue la session depuis " + target)
	for topic in range(Help.TITLES.size()):
		check.call(not Help.text_for(topic, original, 9).is_empty(), "Aide disponible en partie : " + Help.TITLES[topic])
	# Complete all six lessons using keyboard-delivered events and the expected focus.
	scene.show_menu()
	scene.start_tutorial()
	check.call(scene.pause_button.has_focus(), "Clavier : focus initial sur Reprendre")
	await io.key(tree, KEY_ENTER)
	scene.advance_time(0.5)
	check.call(scene.tutorial_next.has_focus(), "Clavier : réussite mène à Continuer")
	await io.key(tree, KEY_ENTER)
	check.call(scene.map_view.buttons[2].has_focus(), "Clavier : Centrale ciblée")
	await io.key(tree, KEY_ENTER)
	await io.key(tree, KEY_ENTER)
	check.call(scene.evolution_open_button.has_focus(), "Clavier : Évolution ciblée")
	await io.key(tree, KEY_ENTER)
	await tree.process_frame
	check.call(scene.evolution_buttons.transmission.has_focus(), "Clavier : Diffusion ciblée")
	check.call("exercice" in scene.evolution_reasons.mobility.text and "Hors exercice" in Help.text_for(0, scene.world, scene.selected, scene.tutorial.stage), "États pédagogiques explicites dans le jeu et l'aide")
	await io.key(tree, KEY_ENTER) # Sélectionner puis focaliser le bouton d'achat explicite.
	await io.key(tree, KEY_ENTER)
	check.call(scene.evolution_back.has_focus(), "Clavier : retour à la carte ciblé après l'achat")
	await io.key(tree, KEY_ENTER)
	await io.key(tree, KEY_ENTER)
	check.call(scene.map_view.buttons[0].has_focus(), "Clavier : Boréale ciblée")
	await io.key(tree, KEY_ENTER)
	await io.key(tree, KEY_ENTER)
	check.call(scene.pause_button.has_focus(), "Clavier : retour à Reprendre pour les fermetures")
	await io.key(tree, KEY_ENTER)
	scene.advance_time(20)
	await io.key(tree, KEY_ENTER)
	scene.advance_time(20)
	await io.key(tree, KEY_ENTER)
	var focused = scene.get_viewport().gui_get_focus_owner()
	check.call(focused is Button and focused.text == "Sauvegardes d'essai", "Clavier : sauvegardes d'essai ciblées")
	await io.key(tree, KEY_ENTER)
	focused = scene.get_viewport().gui_get_focus_owner()
	check.call(focused is Button and focused.text == "Enregistrer ici", "Clavier : emplacement d'essai ciblé")
	await io.key(tree, KEY_ENTER)
	focused = scene.get_viewport().gui_get_focus_owner()
	check.call(focused is Button and focused.text == "Charger", "Clavier : enregistrement mène à Charger")
	await io.key(tree, KEY_ENTER)
	check.call(is_instance_valid(scene.pending_dialog) and scene.pending_dialog.visible and scene.pending_dialog.get_cancel_button().has_focus(), "Clavier : confirmation protège le remplacement")
	await io.key(tree, KEY_TAB)
	await io.key(tree, KEY_ENTER)
	check.call(scene.screen == "game" and scene.tutorial.ready and scene.tutorial_next.has_focus(), "Clavier : chargement confirmé mène à Terminer")
	await io.key(tree, KEY_ENTER)
	check.call(scene.tutorial == null and scene.world == original and scene.screen == "menu", "Clavier : tutoriel entièrement terminé sans souris")
	scene.autosave_enabled = false
	var training_store = Store.new()
	training_store.directory = scene.training_directory
	files.clean(training_store)
	files.clean(original_store)
	scene.queue_free()
	await tree.process_frame
